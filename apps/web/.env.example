# Google Tag Manager. Injected in Layout.astro when the value matches GTM-*.
# Leave empty locally to skip the snippet.
PUBLIC_GTM_ID=

# Source map upload during `astro build`. Create an org auth token at
# https://sentry.io/settings/account/api/auth-tokens/ with `project:releases`
# and `org:read`. Leave empty locally if you do not need source maps.
SENTRY_AUTH_TOKEN=
