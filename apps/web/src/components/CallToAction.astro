---
import { Container, Subheading, Text } from '@carinya-digital/ui';

interface Props {
  headline: string;
  subheadline?: string;
  tone?: 'default' | 'inverse';
  align?: 'start' | 'center';
  class?: string;
}

const {
  headline,
  subheadline,
  tone = 'default',
  align = 'center',
  class: className,
} = Astro.props;
---

<section
  class:list={[
    'py-24',
    tone === 'inverse' && 'dark bg-background text-foreground',
    className,
  ]}
>
  <Container
    className={[
      'flex gap-5',
      align === 'center' && 'max-w-xl flex-col items-center text-center',
      align === 'start' && 'flex-wrap items-end justify-between text-left',
    ]
      .filter(Boolean)
      .join(' ')}
  >
    <div class:list={['flex flex-col gap-3', align === 'start' && 'max-w-[44ch]']}>
      <Subheading className={align === 'center' ? 'max-w-4xl' : undefined}>{headline}</Subheading>
      {subheadline ? <Text>{subheadline}</Text> : null}
    </div>
    <slot />
  </Container>
</section>
