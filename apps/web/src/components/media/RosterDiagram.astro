---
import { Tag } from '@carinya-digital/ui';
import ProductFrame from './ProductFrame.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ProductFrame
  filename="roster.yml"
  label="Coordinator roster with a version-pinned systems-analyst subagent"
  status="Checked"
  class={className}
>
  <div class="flex h-full flex-col gap-3">
    <div class="rounded-sm border border-border bg-background p-4">
      <p class="font-mono text-label uppercase tracking-label text-secondary">Coordinator</p>
      <div class="mt-2 flex flex-wrap items-baseline justify-between gap-2">
        <p class="font-mono text-small text-foreground">daily-changes</p>
        <p class="font-mono text-[13px] text-muted-foreground">v1.4.0</p>
      </div>
    </div>
    <div class="ml-5 border-l border-border pl-4">
      <div class="rounded-sm border border-border bg-background p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="font-mono text-label uppercase tracking-label text-secondary">subagents/</p>
          <Tag>Matched</Tag>
        </div>
        <div class="mt-2 flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-mono text-small text-foreground">systems-analyst</p>
          <p class="font-mono text-[13px] text-muted-foreground">v1.4.0</p>
        </div>
        <p class="mt-2 text-[13px] leading-snug text-muted-foreground">
          Declared on the roster and present on disk. An orphan or an undeclared directory fails the
          build.
        </p>
      </div>
    </div>
  </div>
</ProductFrame>
