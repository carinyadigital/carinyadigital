---
import { Container, TextLink } from '@carinya-digital/ui';
import { footer, site } from '@/content/site';

const columnCountClass = {
  1: 'lg:grid-cols-1',
  2: 'lg:grid-cols-2',
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
  5: 'lg:grid-cols-5',
  6: 'lg:grid-cols-6',
}[footer.length] ?? 'lg:grid-cols-4';
---

<footer class="border-t border-border pt-16">
  <Container className="flex flex-col gap-12 pb-8">
    <nav class:list={['grid grid-cols-2 gap-8 text-small', columnCountClass]} aria-label="Footer">
      {
        footer.map((column) => (
          <div>
            <h2 class="font-mono text-label uppercase tracking-label text-faint-foreground">
              {column.heading}
            </h2>
            <ul class="mt-3 flex flex-col gap-2">
              {column.links.map((link) => (
                <li>
                  {'href' in link ? (
                    <TextLink variant="muted" href={link.href}>
                      {link.label}
                    </TextLink>
                  ) : (
                    <span class="font-mono text-label uppercase tracking-label text-faint-foreground">
                      {link.label}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
      <p class="font-mono text-label uppercase tracking-label text-faint-foreground">
        {site.name}
      </p>
      <p class="text-small text-faint-foreground">{site.tagline}</p>
    </div>
  </Container>
</footer>
