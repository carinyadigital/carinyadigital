---
import { TextLink, Wordmark } from '@carinya-digital/ui';
import { MobileNav } from '@/components/MobileNav';
import { nav } from '@/content/site';
---

<header class="sticky top-0 z-10 border-b border-border bg-background">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
    <Wordmark href="/" />
    <nav class="hidden items-center gap-8 lg:flex">
      {
        nav.items.map((item) => (
          <TextLink variant="nav" href={item.href}>
            {item.label}
          </TextLink>
        ))
      }
      <TextLink variant="action" href={nav.cta.href}>
        {nav.cta.label}
      </TextLink>
    </nav>
    <MobileNav client:load />
  </div>
</header>
