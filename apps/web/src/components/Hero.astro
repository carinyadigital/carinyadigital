---
import { Container, Heading, Text } from '@carinya-digital/ui';

interface Props {
  headline: string;
  subheadline?: string;
  headlineClassName?: string;
  align?: 'start' | 'center';
  tone?: 'default' | 'inverse';
  class?: string;
}

const {
  headline,
  subheadline,
  headlineClassName,
  align = 'start',
  tone = 'default',
  class: className,
} = Astro.props;

const centered = align === 'center';
const hasMedia = Astro.slots.has('media');
---

<section
  class:list={[
    'py-16 sm:py-24',
    tone === 'inverse' && 'dark bg-background text-foreground',
    className,
  ]}
>
  <Container
    className={[
      hasMedia && 'grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16',
      centered && !hasMedia && 'flex flex-col items-center',
    ]
      .filter(Boolean)
      .join(' ')}
  >
    <div class:list={['flex flex-col gap-5', centered && 'items-center text-center']}>
      <slot name="eyebrow" />
      <Heading className={headlineClassName}>{headline}</Heading>
      {
        subheadline ? (
          <Text size="lg" className={centered ? 'max-w-[56ch] text-center' : 'max-w-[56ch]'}>
            {subheadline}
          </Text>
        ) : null
      }
      <slot />
    </div>
    <slot name="media" />
  </Container>
</section>
