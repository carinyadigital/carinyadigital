---
import {
  BorderGrid,
  buttonVariants,
  Card,
  CardDescription,
  CardTitle,
  Container,
  Eyebrow,
  Tag,
  TextLink,
} from '@carinya-digital/ui';
import CallToAction from '@/components/CallToAction.astro';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import { resources, site } from '@/content/site';
---

<Layout
  title="Agent Resources"
  description="Proven agent resources, suitable for any business. Every plugin and agent directory is open source — inspect it, run it yourself, or ask us to run it for you."
>
  <Hero
    headline="agents for the recurring work, ready to install"
    headlineClassName="max-w-[22ch] text-h1"
    subheadline="Proven agent resources, suitable for any business. Every plugin and agent directory below is open source — inspect it, run it yourself, or ask us to run it for you."
  >
    <Eyebrow slot="eyebrow">Agent Resources</Eyebrow>
  </Hero>

  <section class="pb-24">
    <Container>
      <BorderGrid className="grid-cols-1 lg:grid-cols-3">
        {
          resources.map((resource) => (
            <Card className="flex flex-col gap-4 rounded-none p-8">
              <div class="flex items-center justify-between gap-3">
                <Tag>{resource.tag}</Tag>
                <Tag tone="dark">{resource.status}</Tag>
              </div>
              <CardTitle className="mt-0 text-[26px]">{resource.title}</CardTitle>
              <CardDescription className="flex-1 leading-body">{resource.description}</CardDescription>
              <div class="flex flex-wrap items-center gap-5">
                <TextLink href={resource.href}>View resource →</TextLink>
                <TextLink variant="muted" href={resource.githubHref}>
                  GitHub
                </TextLink>
              </div>
            </Card>
          ))
        }
      </BorderGrid>
    </Container>
  </section>

  <CallToAction
    align="start"
    class="border-t border-border py-16"
    headline="watch the repos"
    subheadline="New agent resources go up as they’re built and proven. Nothing to sign up for."
  >
    <a class={buttonVariants({ variant: 'primary' })} href={site.github}>
      GitHub
    </a>
  </CallToAction>
</Layout>
