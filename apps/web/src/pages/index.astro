---
import {
  BorderGrid,
  buttonVariants,
  Card,
  CardDescription,
  CardTitle,
  Container,
  Eyebrow,
  FeatureGrid,
  ImageSlot,
  InverseSurface,
  Subheading,
  Tag,
  Text,
  TextLink,
} from '@carinya-digital/ui';
import CallToAction from '@/components/CallToAction.astro';
import FeatureSplit from '@/components/FeatureSplit.astro';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import { home } from '@/content/site';
---

<Layout>
  <Hero
    headline="less admin, more capacity."
    headlineClassName="max-w-[20ch]"
    subheadline="Carinya Digital designs, builds, and runs AI agents that handle the recurring work inside small and medium businesses — drafting, filing, checking, chasing — so your team spends its time on the work only a person can do."
  >
    <Eyebrow slot="eyebrow">Proven agent resources · Suitable for any business</Eyebrow>
  </Hero>

  <InverseSurface>
    <Container className="grid items-start gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <Eyebrow tone="sage">What we build</Eyebrow>
        <Subheading className="mt-4">
          agents that do<br />the recurring work
        </Subheading>
      </div>
      <div class="flex flex-col gap-5">
        <p class="font-heading text-[22px] leading-snug italic text-foreground">
          “Every business has a stack of work that comes back every week — file notes, meeting prep,
          compliance drafts, follow-ups. We design agents that do that work in the background, on
          your tools, under your review.”
        </p>
        <Text className="max-w-[60ch]">
          We package what we build as open, inspectable agent resources: plugins for Claude Code and
          Claude Cowork, and agent directories you can deploy yourself. Nothing runs unsupervised —
          every output is a draft for a person to review.
        </Text>
      </div>
    </Container>
  </InverseSurface>

  <section class="py-24">
    <Container>
      <FeatureGrid items={[...home.features]} />
    </Container>
  </section>

  <FeatureSplit
    eyebrow={home.cowork.eyebrow}
    headline={home.cowork.headline}
    tone="card"
  >
    <ImageSlot slot="media" label={home.cowork.mediaLabel} className="h-[340px] w-full" />
    <Text className="mb-5">{home.cowork.description}</Text>
    <TextLink href={home.cowork.href}>{home.cowork.linkLabel} →</TextLink>
  </FeatureSplit>

  <FeatureSplit
    eyebrow={home.waratah.eyebrow}
    headline={home.waratah.headline}
    mediaPosition="end"
  >
    <ImageSlot slot="media" label={home.waratah.mediaLabel} className="h-[340px] w-full" />
    <Text className="mb-5">{home.waratah.description}</Text>
    <TextLink href={home.waratah.href}>{home.waratah.linkLabel} →</TextLink>
  </FeatureSplit>

  <section class="bg-card py-24">
    <Container>
      <div class="mb-16 flex flex-wrap items-baseline justify-between gap-5">
        <Subheading>{home.resources.headline}</Subheading>
        <Text className="max-w-[40ch]">{home.resources.description}</Text>
      </div>
      <BorderGrid className="grid-cols-1 sm:grid-cols-2">
        {
          home.resources.items.map((resource) => (
            <Card className="flex flex-col gap-3.5 rounded-none">
              <Tag>{resource.tag}</Tag>
              <CardTitle>{resource.title}</CardTitle>
              <CardDescription className="flex-1">{resource.description}</CardDescription>
              <TextLink href={resource.href}>{resource.linkLabel} →</TextLink>
            </Card>
          ))
        }
      </BorderGrid>
    </Container>
  </section>

  <CallToAction
    align="start"
    class="border-t border-border py-16"
    headline="follow along"
    subheadline="New agent resources go up as they’re built and proven. Watch the repos for updates — nothing to sign up for."
  >
    <a class={buttonVariants({ variant: 'primary' })} href="/agent-resources">
      Browse Agent Resources
    </a>
  </CallToAction>
</Layout>
