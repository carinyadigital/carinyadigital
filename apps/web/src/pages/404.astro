---
import { buttonVariants, Eyebrow, TextLink } from '@carinya-digital/ui';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';

// Hosts serve this document for unknown routes. Setting 404 here means
// on-demand rendering and the preview server send a real Not Found
// status instead of a 200 that only looks like an error page.
Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<Layout
  title="Page not found"
  description="The page you were looking for could not be found."
  robots="noindex, nofollow"
  canonical={false}
>
  <Hero
    align="center"
    class="py-24 sm:py-32"
    headline="Page not found"
    subheadline="The page you were looking for could not be found."
  >
    <Eyebrow slot="eyebrow">404</Eyebrow>
    <a class={buttonVariants({ variant: 'primary' })} href="/">Go back home</a>
    <TextLink href="/agent-resources">Browse Agent Resources →</TextLink>
  </Hero>
</Layout>
