---
import { buttonVariants, Eyebrow, TextLink } from '@carinya-digital/ui';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you were looking for could not be found.">
  <Hero
    align="center"
    class="py-24 sm:py-32"
    headline="Page not found"
    subheadline="The page you were looking for could not be found."
  >
    <Eyebrow slot="eyebrow">404</Eyebrow>
    <a class={buttonVariants({ variant: 'primary' })} href="/">Go back home</a>
    <TextLink href="/agent-resources">Browse Agent Resources →</TextLink>
  </Hero>
</Layout>
