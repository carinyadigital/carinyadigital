    <table>
      <thead>
        <tr>
          <th scope="col">Information</th>
          <th scope="col">How long we keep it</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Enquiries and correspondence</td>
          <td>2 years after our last contact, or longer while a matter is open</td>
        </tr>
